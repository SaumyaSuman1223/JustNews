# Copy to .env for local dev. Real secrets never live in git.
# Deployed environments read these from Google Secret Manager instead.

APP_ENV=local
LOG_LEVEL=debug

# --- database ---
POSTGRES_USER=justnews
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=justnews
DATABASE_URL=postgresql+asyncpg://justnews:change_me_locally@localhost:5432/justnews
# halfvec halves embedding storage and needs pgvector >= 0.7, which Supabase
# and the pgvector/pgvector docker image both have. Set this to "vector" only
# when running against an older pgvector (scripts/devdb.py).
VECTOR_TYPE=halfvec

# --- cache / queue ---
REDIS_URL=redis://localhost:6379/0

# --- services ---
API_URL=http://localhost:8000
# The public origin, no trailing slash - used for the sitemap, canonicals and
# structured data. No domain is registered yet (see ROADMAP.md "Still open"),
# so this is the only thing that needs to change once one is.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- supabase (auth + db + storage) ---
# SUPABASE_URL is read by the API itself, to verify JWTs against
# "$SUPABASE_URL/auth/v1/.well-known/jwks.json". NEXT_PUBLIC_* is what the
# web app ships to the browser for Supabase's own client library - the two
# point at the same project but are read by different processes.
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- content sources ---
GNEWS_API_KEY=
INGEST_USER_AGENT=JustNewsBot/0.1 (+https://example.com/bot)
INGEST_MAX_GNEWS_CALLS_PER_DAY=100

# --- cache / rate limit ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- observability ---
SENTRY_DSN=

# --- news encoder ---
# "hashing" is deterministic, needs no model download and runs in CI in
# milliseconds - but it is lexical, so it will not match the same story across
# languages. Production must use sentence-transformers (ADR 0005).
EMBEDDER=hashing
EMBEDDING_DIM=384
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- dedup thresholds ---
DEDUP_SIMHASH_MAX_DISTANCE=3
DEDUP_EMBEDDING_MIN_COSINE=0.86
DEDUP_WINDOW_HOURS=72

# --- retention (500 MB free tier) ---
ARTICLE_RETENTION_DAYS=90
