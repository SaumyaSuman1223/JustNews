# Copy to .env.local for local dev (Next.js's own convention — read
# automatically, independent of the backend's .env). Real secrets never live
# in git. Deployed environments set these directly on Vercel.

# --- backend ---
API_URL=http://localhost:8000

# --- public origin, no trailing slash - used for the sitemap, canonicals and
# structured data. No domain is registered yet (see ROADMAP.md "Still open"),
# so this is the only thing that needs to change once one is. ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- supabase (auth) - read by the browser client, so these must be the
# anon/public key, never the service role key. Same project as the backend's
# SUPABASE_URL in the root .env.example, but this app never talks to Postgres
# directly - only Supabase Auth. ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
